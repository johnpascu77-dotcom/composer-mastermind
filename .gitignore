# Build output
build/
cmake-build-*/
out/
Release/
Debug/

# Vendored JUCE checkout: has its own nested .git, hundreds of MB, not
# ours to version. Set it up by cloning JUCE into external/JUCE yourself
# (or turn it into a proper git submodule later) rather than committing it.
external/JUCE/

# JUCE / IDE
*.xcuserstate
*.suo
*.user
*.VC.db
*.VC.opendb
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Temporary / cache
*.tmp
*.log
__pycache__/
*.pyc

# OrchCapture live-testing session dumps (scratch output, not project content)
docs/OrchCapture_session_*.mid

# Local machine-specific MCP server config (hardcoded absolute paths)
.mcp.json

# score-generator window: the user's own remembered settings
score-generator/slice_score_gui_settings.json
score-generator/slice_midi_gui_settings.json
